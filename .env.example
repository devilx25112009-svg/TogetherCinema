# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STORAGE_PROVIDER: "s3" (MinIO / S3-compatible primary storage) | "local"
STORAGE_PROVIDER="s3"

# LOCAL_STORAGE_DIR: Local folder for lightweight upload session metadata
LOCAL_STORAGE_DIR=".cinema-storage"

# STORAGE_QUOTA_BYTES: Default per-couple quota in bytes (50 GiB = 53687091200)
STORAGE_QUOTA_BYTES="53687091200"

# MEDIA_SIGNING_SECRET: HMAC secret for short-lived signed playback URLs
MEDIA_SIGNING_SECRET="change-me-in-production"

# MinIO / S3-Compatible Object Storage (when STORAGE_PROVIDER="s3")
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="together-cinema-media"
S3_FORCE_PATH_STYLE="true"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Google Cloud Storage (when STORAGE_PROVIDER="gcs")
GCS_BUCKET=""
GCS_PROJECT_ID=""

# CDN_PLAYBACK_BASE_URL: Optional CDN edge URL for signed HLS/DASH streams
CDN_PLAYBACK_BASE_URL=""

# FFMPEG_BIN / FFPROBE_BIN: Optional explicit paths for video processing worker
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"

# GIPHY_API_KEY or TENOR_API_KEY: Optional GIF provider key for live cinema chat
GIPHY_API_KEY=""

# Multi-Server Cloud Synchronization (Vercel Serverless / Multi-Instance Node)
# Optional Vercel KV / Upstash Redis REST credentials for instant multi-server room & playback state sharing
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Optional Firebase Service Account JSON for server-side Cloud Firestore REST persistence
FIREBASE_SERVICE_ACCOUNT_JSON=""

